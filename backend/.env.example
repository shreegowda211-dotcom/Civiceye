# Backend environment settings - DO NOT COMMIT REAL VALUES TO GIT
# Create a local .env file with actual values (add to .gitignore)

# MongoDB connection string (Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/civiceye?retryWrites=true&w=majority&appName=ClusterName

# MongoDB fallback connection (non-SRV)
MONGO_URI_FALLBACK=mongodb://username:password@host1:27017,host2:27017,host3:27017/civiceye?authSource=admin&retryWrites=true&w=majority&tls=true

# Server port
PORT=5003

# JWT signing secret - MUST be set and strong
JWT_SECRET=your-strong-secret-here-min-32-chars

# Default seed password for demo users
SEED_DEFAULT_PASSWORD=demo1234

# CORS origin for frontend (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com
